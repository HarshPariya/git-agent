# ──────────────────────────────────────────────────────────────────────────────
# Git-Agent Environment Configuration — Production Template (.env.production.example)
# Use these values when configuring Environment Variables in Vercel, Docker, or Cloud Host.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PUBLIC_DIR=./public
# Set to your production domain(s), comma-separated if multiple (e.g. https://your-app.vercel.app)
CORS_ORIGIN=https://your-production-app.vercel.app

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# MongoDB Atlas Connection String (ensure Network Access IP allowlist includes 0.0.0.0/0 or Vercel IPs)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net
MONGODB_DB_NAME=git_debugging_agent
MONGO_POOL_MAX=10

# ── Authentication & Security ────────────────────────────────────────────────
# Generate a secure 64-char key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-unique-64-character-random-secret
# Google OAuth 2.0 Client ID (Authorized Javascript origins must include your production domain)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── AI / LLM (Groq) ──────────────────────────────────────────────────────────
# Required in production (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_production_groq_api_key_here
# Production model (groq/compound, openai/gpt-oss-120b, or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ── RAG Configuration ────────────────────────────────────────────────────────
MAX_RAG_CONTEXT_TOKENS=1200
MAX_MEMORY_TOKENS=300
MAX_RETRIEVED_CHUNKS=4
RAG_DEBUG_CONTEXT=false

# ── Repository & Workspaces ──────────────────────────────────────────────────
WORKSPACE_ROOT=./
REPOSITORY_ROOT=
# Optional: comma-separated list of permitted repository directory paths
WORKSPACE_ALLOWLIST=

# ── Guardrails & Content Limits ──────────────────────────────────────────────
MAX_MESSAGE_LENGTH=64000
MAX_RESPONSE_LENGTH=64000

# ── Search & Indexing Limits ─────────────────────────────────────────────────
MAX_QUERY_LENGTH=2000
MAX_RESULTS=50
DEFAULT_RESULTS=10
MAX_FILE_SIZE_BYTES=1048576
MAX_CHUNK_SIZE_BYTES=32768
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_SIZE_BYTES=524288000
MAX_REPOSITORY_CHUNKS=100000
MAX_GRAPH_DEPTH=5
MAX_GRAPH_NODES_VISITED=1000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ── LLM Cost Tracking ────────────────────────────────────────────────────────
LLM_MAX_COST_PER_REQUEST=0.50
LLM_DAILY_BUDGET=10.00
