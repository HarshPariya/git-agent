NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=ai_chatbot

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-unique-64-character-random-secret
CORS_ORIGIN=https://your-app.example.com

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound
MAX_RAG_CONTEXT_TOKENS=1200
MAX_RETRIEVED_CHUNKS=4
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: absolute workspace roots permitted for the workspace API.
WORKSPACE_ALLOWLIST=/workspace
