{
  "name": "ai-chatbot",
  "version": "1.0.0",
  "description": "Production-ready GraphRAG AI chatbot",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "rag:parse": "tsx src/ingestion/test-parser.ts",
    "rag:graph": "tsx src/retrieval/test-graph-search.ts",
    "rag:vector": "tsx src/retrieval/test-vector-search.ts",
    "rag:hybrid": "tsx src/retrieval/test-hybrid-search.ts",
    "rag:retrieve": "tsx src/retrieval/test-retriever.ts",
    "tool:search-code": "tsx src/tools/test-search-code.ts",
    "db:test": "tsx src/db/test-database.ts",
    "db:vector": "tsx src/db/test-vector-store.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "rag:eval": "tsx src/retrieval/eval.ts",
    "rag:ablation": "tsx src/retrieval/ablation-eval.ts",
    "rag:security-test": "tsx src/ingestion/test-security.ts",
    "rag:embed-test": "tsx src/ingestion/test-embedder.ts",
    "rag:indexer-test": "tsx src/ingestion/test-indexer.ts",
    "rag:limits-test": "tsx src/guardrails/test-limits.ts",
    "rag:integration-test": "tsx src/retrieval/test-integration.ts",
    "db:backup-test": "tsx src/db/test-backup.ts",
    "tool:impact-analysis": "tsx src/tools/test-impact-analysis.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshPariya/ai-chatbot.git"
  },
  "keywords": [
    "ai",
    "chatbot",
    "graphrag",
    "postgresql",
    "pgvector"
  ],
  "author": "HarshPariya",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HarshPariya/ai-chatbot/issues"
  },
  "homepage": "https://github.com/HarshPariya/ai-chatbot#readme",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "openai": "^5.23.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
