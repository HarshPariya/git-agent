{
  "name": "ai-chatbot",
  "version": "2.0.0",
  "description": "Autonomous AI Git Debugging Agent",
  "type": "module",
  "main": "dist/src/app.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/src/app.js",
    "test": "tsx tests/run-all.ts",
    "test:git": "tsx tests/git-engine.test.ts",
    "test:agent": "tsx tests/agent-orchestrator.test.ts",
    "test:api": "tsx tests/api.test.ts",
    "test:guardrails": "tsx tests/guardrails.test.ts",
    "test:desktop": "tsx tests/git-desktop.test.ts",
    "rag:parse": "tsx src/ingestion/test-parser.ts",
    "rag:graph": "tsx src/retrieval/test-graph-search.ts",
    "rag:vector": "tsx src/retrieval/test-vector-search.ts",
    "rag:hybrid": "tsx src/retrieval/test-hybrid-search.ts",
    "rag:retrieve": "tsx src/retrieval/test-retriever.ts",
    "db:test": "tsx src/db/test-database.ts",
    "db:vector": "tsx src/db/test-vector-store.ts",
    "rag:eval": "tsx src/retrieval/eval.ts",
    "rag:ablation": "tsx src/retrieval/ablation-eval.ts",
    "rag:security-test": "tsx src/ingestion/test-security.ts",
    "rag:embed-test": "tsx src/ingestion/test-embedder.ts",
    "rag:indexer-test": "tsx src/ingestion/test-indexer.ts",
    "rag:limits-test": "tsx src/guardrails/test-limits.ts",
    "rag:integration-test": "tsx src/retrieval/test-integration.ts",
    "db:backup-test": "tsx src/db/test-backup.ts",
    "tool:search-code": "tsx src/retrieval/test-graph-search.ts",
    "tool:impact-analysis": "tsx src/retrieval/test-retriever.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"{src,tests,api}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,api}/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshPariya/git-agent.git"
  },
  "keywords": [
    "ai",
    "git",
    "debugging",
    "agent",
    "graphrag",
    "mongodb",
    "atlas-vector-search"
  ],
  "author": "HarshPariya",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HarshPariya/ai-chatbot/issues"
  },
  "homepage": "https://github.com/HarshPariya/ai-chatbot#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "groq-sdk": "^1.6.0",
    "mongodb": "^7.6.0",
    "openai": "^5.23.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.70.0"
  }
}