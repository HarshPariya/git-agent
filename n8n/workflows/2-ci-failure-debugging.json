{
  "name": "2 - CI Failure Debugging Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-failure-webhook",
        "options": {}
      },
      "id": "node-ci-webhook",
      "name": "Webhook - CI Failure",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 300],
      "webhookId": "ci-failure-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.workflow_run ? $json.body.workflow_run.conclusion : ($json.body.status || 'failure') }}",
              "operation": "equal",
              "value2": "failure"
            }
          ]
        }
      },
      "id": "node-if-ci-failed",
      "name": "If Failure",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.GIT_AGENT_URL || 'https://git-agent.onrender.com') + '/api/internal/automation/ci-failure' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Key",
              "value": "={{ $env.N8N_API_KEY || 'test-n8n-key' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"repository\": \"{{ $json.body.repository ? ($json.body.repository.full_name || $json.body.repository.name) : 'repository' }}\",\n  \"runId\": \"{{ $json.body.workflow_run ? $json.body.workflow_run.id : ($json.body.runId || '0') }}\",\n  \"commitSha\": \"{{ $json.body.workflow_run ? $json.body.workflow_run.head_sha : ($json.body.sha || '') }}\",\n  \"branch\": \"{{ $json.body.workflow_run ? $json.body.workflow_run.head_branch : ($json.body.branch || 'main') }}\",\n  \"failureLogs\": \"{{ $json.body.logs || $json.body.error || 'CI check run failed' }}\"\n}",
        "options": {}
      },
      "id": "node-diagnose-ci",
      "name": "Git Agent - Diagnose CI Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 240]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.diagnosed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-diagnosed",
      "name": "If Root Cause Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [920, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.github.com/repos/' + ($('Webhook - CI Failure').item.json.body.repository ? $('Webhook - CI Failure').item.json.body.repository.full_name : 'owner/repo') + '/commits/' + ($('Webhook - CI Failure').item.json.body.workflow_run ? $('Webhook - CI Failure').item.json.body.workflow_run.head_sha : 'HEAD') + '/comments' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "Git-Agent-CI-Debugger"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": \"🚨 **Git Agent AI - CI Failure Diagnosis**\\n\\n**Root Cause:**\\n{{ $json.rootCause }}\\n\\n**Suggested Remediation:**\\n{{ $json.suggestedFix }}\\n\\n```diff\\n{{ $json.autoFixPatch || '(Inspect in Git Agent UI)' }}\\n```\\n\\n*Automated diagnostic report generated by Git Agent.*\"\n}",
        "options": {}
      },
      "id": "node-notify-commit-comment",
      "name": "GitHub - Post Failure Diagnosis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1160, 180]
    }
  ],
  "connections": {
    "Webhook - CI Failure": {
      "main": [
        [
          {
            "node": "If Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Failure": {
      "main": [
        [
          {
            "node": "Git Agent - Diagnose CI Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Git Agent - Diagnose CI Failure": {
      "main": [
        [
          {
            "node": "If Root Cause Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Root Cause Found": {
      "main": [
        [
          {
            "node": "GitHub - Post Failure Diagnosis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
