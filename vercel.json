{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/ready",
      "destination": "/api"
    }
  ],
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "regions": [
    "iad1"
  ]
}