# ──────────────────────────────────────────────────────────────────────────────
# Git-Agent Environment Configuration — Development / Template (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_DIR=./public
CORS_ORIGIN=*

# ── Database (MongoDB Atlas / Local) ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=git_debugging_agent
MONGO_POOL_MAX=10

# ── Authentication & Security ────────────────────────────────────────────────
# Development secret key. In production, use a strong 64-char random hex string.
AUTH_SECRET=development-only-auth-secret-change-in-production
# Google OAuth 2.0 Client ID (optional for local testing, required for Google sign-in)
GOOGLE_CLIENT_ID=

# ── AI / LLM (Groq) ──────────────────────────────────────────────────────────
# Required in development & production (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Model selection (fallback chain: qwen3.8-27b, gpt-oss-120b, gpt-oss-20b, etc.)
GROQ_MODEL=openai/gpt-oss-120b

# ── RAG Configuration ────────────────────────────────────────────────────────
MAX_RAG_CONTEXT_TOKENS=1200
MAX_MEMORY_TOKENS=300
MAX_RETRIEVED_CHUNKS=4
RAG_DEBUG_CONTEXT=false

# ── Repository & Workspaces ──────────────────────────────────────────────────
WORKSPACE_ROOT=./
REPOSITORY_ROOT=
WORKSPACE_ALLOWLIST=

# ── Guardrails & Content Limits ──────────────────────────────────────────────
MAX_MESSAGE_LENGTH=64000
MAX_RESPONSE_LENGTH=64000

# ── Search & Indexing Limits ─────────────────────────────────────────────────
MAX_QUERY_LENGTH=2000
MAX_RESULTS=50
DEFAULT_RESULTS=10
MAX_FILE_SIZE_BYTES=1048576
MAX_CHUNK_SIZE_BYTES=32768
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_SIZE_BYTES=524288000
MAX_REPOSITORY_CHUNKS=100000
MAX_GRAPH_DEPTH=5
MAX_GRAPH_NODES_VISITED=1000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ── LLM Cost Tracking ────────────────────────────────────────────────────────
LLM_MAX_COST_PER_REQUEST=0.50
LLM_DAILY_BUDGET=10.00
