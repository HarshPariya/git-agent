# Server
PORT=3000
NODE_ENV=development
PUBLIC_DIR=./public
CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5433/ai_chatbot
PG_POOL_MAX=10

# Authentication
AUTH_SECRET=development-only-auth-secret

# AI/LLM
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=groq/compound

# RAG Configuration
MAX_RAG_CONTEXT_TOKENS=1200
MAX_MEMORY_TOKENS=300
MAX_RETRIEVED_CHUNKS=4
RAG_DEBUG_CONTEXT=false

# Repository
WORKSPACE_ROOT=./
REPOSITORY_ROOT=
WORKSPACE_ALLOWLIST=

# Guardrails
MAX_MESSAGE_LENGTH=64000
MAX_RESPONSE_LENGTH=64000

# Limits
MAX_QUERY_LENGTH=2000
MAX_RESULTS=50
DEFAULT_RESULTS=10
MAX_FILE_SIZE_BYTES=1048576
MAX_CHUNK_SIZE_BYTES=32768
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_SIZE_BYTES=524288000
MAX_REPOSITORY_CHUNKS=100000
MAX_GRAPH_DEPTH=5
MAX_GRAPH_NODES_VISITED=1000

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# LLM Cost
LLM_MAX_COST_PER_REQUEST=0.50
LLM_DAILY_BUDGET=10.00
